+def wait_postboot_listener(name='svpersist', timeout_seconds=150):
+    """Wait for both systemd and a real listening socket after restore.service.
+
+    This waits instead of treating normal systemd startup ordering as a failure.
+    It does not start, restart, or modify the node or security rules.
+    """
+    p=port(name)
+    unit=f'vless-temp-{name}.service'
+    deadline=time.monotonic()+timeout_seconds
+    last_state=None
+    while True:
+        rc,state=shell(['systemctl','is-active',unit],timeout=8)
+        active=(rc==0 and state.strip()=='active')
+        if state != last_state:
+            msg(f'CASE 14 readiness: unit={unit}, systemd={state.strip()}')
+            last_state=state
+        if active and tcp_probe(p,'127.0.0.2',timeout=1.5):
+            return p
+        if time.monotonic()>=deadline:
+            evidence=[]
+            for args in (
+                ['systemctl','status',unit,'--no-pager','-l'],
+                ['journalctl','-b','-u',unit,'--no-pager','-n','30'],
+                ['journalctl','-b','-u','vless-managed-restore.service','--no-pager','-n','30'],
+            ):
+                try:
+                    _,out=shell(args,timeout=12)
+                    evidence.append(out[-1500:])
+                except Exception as exc:evidence.append(str(exc))
+            (RUN/'case14-timeout-diagnostics.txt').write_text('\n----\n'.join(evidence))
+            raise CaseFail(f'{unit} not active+listening after {timeout_seconds}s; diagnostics saved')
+        time.sleep(min(3,max(0,deadline-time.monotonic())))
+
+
